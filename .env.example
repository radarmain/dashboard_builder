# Copy to .env (never commit .env). Local dev uses the `concrete` profile against real AWS.
# `scripts/deploy.sh` fills the deploy-derived values below from the CloudFormation outputs.
AWS_PROFILE=concrete
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2

# Deploy-derived (from rdb-core outputs)
RDB_TABLE_NAME=
RDB_DATA_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
RDB_API_ROLE_ARN=

# Existing secret holding the BigQuery service account JSON (read-only, never print or log values)
RDB_GBQ_SECRET_NAME=GBQ_lambda_secrets
RDB_GBQ_SECRET_KEY=GLOBAL_GBQ_KEY

# Bedrock model / inference profile for chat-to-spec
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# Default BigQuery byte cap per query (10 GB), overridable per project
BQ_DEFAULT_MAX_BYTES_BILLED=10000000000

# Frontend: scripts/write_env.py writes the public VITE_ values below into frontend/builder/.env.local.
# VITE_API_URL: leave blank in dev (Vite proxies /api to localhost:8000); set for deployed builds.
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_AWS_REGION=us-east-2
